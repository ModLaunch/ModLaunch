<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ModLaunch 4 — нативная версия на Avalonia UI (.NET 8).
    Сборка под Windows: dotnet publish -c Release -r win-x64
    (одним exe, со своей средой .NET, без Electron и Chromium).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ModLaunch</AssemblyName>
    <RootNamespace>ModLaunch</RootNamespace>
    <Version>21.0.0</Version>
    <Product>ModLaunch</Product>
    <Company>ModLaunch</Company>
    <Copyright>© 2026 ModLaunch</Copyright>
    <AssemblyTitle>ModLaunch</AssemblyTitle>
    <Description>ModLaunch — mods in one click</Description>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Переводы сообщений компилятора — только нужных языков. -->
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Выпуск: один exe со своей средой .NET, урезанный от лишнего. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 12.0: без сжатия. Сжатый exe без подписи Chrome и Защитник Windows принимали за упакованный
         вирус; несжатый весит больше, но такие ложные тревоги у него бывают реже. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- 8.4.1: сериализация через отражение остаётся включённой — иначе любое
         JsonSerializer.Serialize или JsonArray.Add(строка) роняло программу в выпуске. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <DebugType>none</DebugType>
    <!-- 15.0: код заранее переведён в машинный (ReadyToRun) — и свой, и Avalonia. Без этого каждое
         первое нажатие (страница, меню, кнопка окна) ждало, пока .NET скомпилирует код на лету. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" Exclude="Assets/*.tsv.gz" />
    <!-- 9.7: ModScript X — инжектор .modx (desktop/ModScript), встроен в Creator Hub. -->
    <Compile Include="../ModScript/Modx.cs;../ModScript/Lang.cs;../ModScript/Targets.cs;../ModScript/Engines.cs;../ModScript/Bridge.cs;../ModScript/Injector.cs;../ModScript/Runtime.cs" Link="ModScriptX/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../ModScript/Examples/gold-boost.modx" Link="Assets/modscriptx/gold-boost.modx" />
    <AvaloniaResource Include="../ModScript/Examples/arena.modx" Link="Assets/modscriptx/arena.modx" />
    <!-- 9.5: полный файл правил Firestore — тот же, что в firebase/ (его проверяют тесты на эмуляторе) -->
    <AvaloniaResource Include="../../firebase/firestore.rules" Link="Assets/firestore.rules" />
    <!-- Настройки служб читаются и без запущенного интерфейса (самопроверка, установщик). -->
    <EmbeddedResource Include="Assets/*.config.json" LogicalName="%(Filename)%(Extension)" />
    <!-- 15.0: все игры Steam (100 тыс.+) — снимок собирает CI (gamedir.yml); пока его нет, сборка без него. -->
    <EmbeddedResource Include="Assets/*.tsv.gz" LogicalName="%(Filename)%(Extension)" />
    <TrimmerRootAssembly Include="ModLaunch" />
    <EmbeddedResource Include="$(PkgMicrosoft_CSharp)/lib/netstandard2.0/Microsoft.CSharp.dll" LogicalName="modscript-Microsoft.CSharp.dll" Condition="'$(PkgMicrosoft_CSharp)' != ''" />
    <!-- Компилятор нужен редко (сборка Unity-инжекта) — без ReadyToRun, чтобы не раздувать установщик. -->
    <PublishReadyToRunExclude Include="Microsoft.CodeAnalysis.dll;Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.*" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.*" />
    <PackageReference Include="SharpCompress" Version="1.0.*" />
    <!-- 15.0: C#-моды для Unity собираются прямо в программе (Roslyn) — .NET SDK у игрока не нужен. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <!-- Microsoft.CSharp под netstandard2.0 кладётся рядом с собранным плагином (dynamic в ModScript X 2). -->
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.*" />
  </ItemGroup>

</Project>
