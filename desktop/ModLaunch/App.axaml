<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModLaunch.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Цвета — те же токены, что в styles.css версии 3.x. -->
      <Color x:Key="BgColor">#0F1116</Color>
      <SolidColorBrush x:Key="Bg" Color="#0F1116"/>
      <SolidColorBrush x:Key="Rail" Color="#12141A"/>
      <SolidColorBrush x:Key="Surface" Color="#171A21"/>
      <SolidColorBrush x:Key="Surface2" Color="#1E222B"/>
      <SolidColorBrush x:Key="Surface3" Color="#262B36"/>
      <SolidColorBrush x:Key="Line" Color="#2A2F3B"/>
      <SolidColorBrush x:Key="Text" Color="#E8EBF2"/>
      <SolidColorBrush x:Key="Muted" Color="#98A1B2"/>
      <SolidColorBrush x:Key="Faint" Color="#6B7385"/>
      <SolidColorBrush x:Key="Brand" Color="#7C5CFF"/>
      <SolidColorBrush x:Key="Brand2" Color="#9D85FF"/>
      <SolidColorBrush x:Key="BrandSoft" Color="#2A2350"/>
      <SolidColorBrush x:Key="Good" Color="#3DD68C"/>
      <SolidColorBrush x:Key="Warn" Color="#F2B84B"/>
      <SolidColorBrush x:Key="Bad" Color="#FF6B6B"/>
      <SolidColorBrush x:Key="Hover" Color="#FFFFFF" Opacity="0.06"/>
      <FontFamily x:Key="ContentControlThemeFontFamily">fonts:Inter#Inter</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#7C5CFF" RegionColor="#0F1116" ErrorText="#FF6B6B"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource Bg}"/>
      <Setter Property="FontFamily" Value="fonts:Inter#Inter"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <!-- Текст -->
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="TextBlock.h3"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
    <Style Selector="TextBlock.small"><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="TextBlock.brand"><Setter Property="Foreground" Value="{StaticResource Brand2}"/></Style>

    <!-- Карточки -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <!-- Кнопки: общая основа -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="BackEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <!-- Плавная смена цвета при наведении у всех кнопок -->
    <Style Selector="Button /template/ ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3}"/>
      <Setter Property="BorderBrush" Value="#3A4150"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <!-- Нажатие «пружинит»: сжимается и отскакивает обратно (BackEaseOut) -->
    <Style Selector="Window.juicy Button:pressed"><Setter Property="RenderTransform" Value="scale(0.93)"/></Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Brand}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Brand2}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3}"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}"/>
    </Style>

    <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.45"/></Style>

    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.win">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.win:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource Hover}"/></Style>
    <Style Selector="Button.close:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#E5484D"/></Style>

    <!-- Чипы разделов и вкладки -->
    <Style Selector="Button.chip">
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style Selector="Button.chip.active">
      <Setter Property="Background" Value="{StaticResource Brand}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.chip.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Brand2}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="ToggleButton.chip">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#E5484D"/>
      <Setter Property="BorderBrush" Value="#E5484D"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Padding" Value="16,10"/>
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="Background" Value="{StaticResource BrandSoft}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <!-- Кнопки игр на боковой панели -->
    <Style Selector="Button.rail">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Button.rail.active"><Setter Property="BorderBrush" Value="{StaticResource Brand}"/></Style>
    <Style Selector="Button.rail:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource Hover}"/></Style>

    <!-- Плитки игр -->
    <Style Selector="Button.tile">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter"><Setter Property="BorderBrush" Value="{StaticResource Brand}"/></Style>

    <!-- Поля ввода -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderBrush" Value="#3A4150"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinHeight" Value="40"/>
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource Brand}"/>
      <Setter Property="Background" Value="{StaticResource Surface3}"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="MinHeight" Value="6"/>
      <Setter Property="Height" Value="6"/>
    </Style>

    <Style Selector="ScrollViewer">
      <Setter Property="AllowAutoHide" Value="True"/>
    </Style>

    <!-- Мягкое появление страниц -->
    <Style Selector="ContentControl#Page > :is(Control)">
      <Style.Animations>
        <Animation Duration="0:0:0.18" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- 5.6: спокойный стиль без тяжёлых анимаций — только смена цвета при наведении. -->
    <Style Selector="Border.hero"><Setter Property="Background" Value="{StaticResource Surface}"/></Style>
    <Style Selector="Button.card-btn">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Transitions"><Transitions/></Setter>
    </Style>
    <Style Selector="Button.card-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderBrush" Value="#3A4150"/>
    </Style>
    <Style Selector="Button.card-btn">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="BackEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.juicy Button.card-btn:pointerover"><Setter Property="RenderTransform" Value="translateY(-4px)"/></Style>
    <Style Selector="Window.juicy Button.card-btn:pressed"><Setter Property="RenderTransform" Value="translateY(-1px) scale(0.97)"/></Style>
    <Style Selector="Button.cover-btn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Transitions"><Transitions/></Setter>
    </Style>
    <Style Selector="Button.cover-btn:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Window.juicy Button.cover-btn:pressed"><Setter Property="RenderTransform" Value="scale(0.96)"/></Style>
    <!-- Обложка: подъём с тенью, картинка приближается, кнопка «Играть» выпрыгивает -->
    <Style Selector="Border.cover-art">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="BackEaseOut"/>
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.juicy Button.cover-btn:pointerover Border.cover-art">
      <Setter Property="RenderTransform" Value="translateY(-7px) scale(1.03)"/>
      <Setter Property="BoxShadow" Value="0 20 34 -12 #C0000000"/>
    </Style>
    <Style Selector="Image.zoom">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.6" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.juicy Button.cover-btn:pointerover Image.zoom, Window.juicy Button.card-btn:pointerover Image.zoom">
      <Setter Property="RenderTransform" Value="scale(1.08)"/>
    </Style>
    <Style Selector="Button.cover-btn Button.cover-play">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.34" Easing="BackEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.juicy Button.cover-btn Button.cover-play"><Setter Property="RenderTransform" Value="translateY(10px) scale(0.5)"/></Style>
    <Style Selector="Button.cover-btn:pointerover Button.cover-play"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Window.juicy Button.cover-btn:pointerover Button.cover-play"><Setter Property="RenderTransform" Value="translateY(0px) scale(1)"/></Style>
    <Style Selector="Window.juicy Button.cover-btn:pointerover Button.cover-play:pressed"><Setter Property="RenderTransform" Value="scale(0.88)"/></Style>
    <!-- Боковая панель: значки чуть подпрыгивают -->
    <Style Selector="Window.juicy Button.rail:pointerover"><Setter Property="RenderTransform" Value="scale(1.1)"/></Style>
    <Style Selector="Window.juicy Button.rail:pressed"><Setter Property="RenderTransform" Value="scale(0.9)"/></Style>
    <!-- Вкладки и чипы: активная слегка «вдавлена» -->
    <Style Selector="Window.juicy Button.tab:pointerover, Window.juicy Button.chip:pointerover"><Setter Property="RenderTransform" Value="translateY(-2px)"/></Style>
    <Style Selector="Button.cover-btn:pointerover Border"><Setter Property="BorderBrush" Value="{StaticResource Brand}"/></Style>
    <!-- Big Picture -->
    <Style Selector="Button.bp-cover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="3"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Opacity" Value="0.7"/>
      <Setter Property="RenderTransform" Value="scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.34" Easing="BackEaseOut"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.bp-cover:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.bp-cover.selected">
      <Setter Property="BorderBrush" Value="White"/>
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="RenderTransform" Value="scale(1.1)"/>
    </Style>
    <Style Selector="Button.bp-cover.selected:pointerover /template/ ContentPresenter"><Setter Property="BorderBrush" Value="White"/></Style>
    <Style Selector="Button.bp-action, Button.bp-row, Button.bp-icon">
      <Setter Property="Background" Value="#33FFFFFF"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.bp-action:pointerover /template/ ContentPresenter, Button.bp-row:pointerover /template/ ContentPresenter, Button.bp-icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#4DFFFFFF"/>
    </Style>
    <Style Selector="Button.bp-action.primary-bp"><Setter Property="Background" Value="{StaticResource Brand}"/></Style>
    <Style Selector="Button.bp-action.primary-bp:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource Brand2}"/></Style>
    <Style Selector="Button.bp-action.focused, Button.bp-row.focused"><Setter Property="BorderBrush" Value="White"/></Style>
    <Style Selector="Window.juicy Button.bp-action.focused"><Setter Property="RenderTransform" Value="scale(1.07)"/></Style>
    <Style Selector="Window.juicy Button.bp-row.focused"><Setter Property="RenderTransform" Value="translateX(8px)"/></Style>
    <Style Selector="Window.juicy Button.bp-action:pointerover"><Setter Property="RenderTransform" Value="scale(1.04)"/></Style>
    <Style Selector="Button.bp-row"><Setter Property="Background" Value="#14FFFFFF"/></Style>
    <Style Selector="Button.bp-row.focused"><Setter Property="Background" Value="#2EFFFFFF"/></Style>

    <Style Selector="Border.skeleton"><Setter Property="Background" Value="{StaticResource Surface2}"/></Style>
    <Style Selector="Button.card-btn.dashed">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Application.Styles>
</Application>
