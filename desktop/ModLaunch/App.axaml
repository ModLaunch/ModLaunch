<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModLaunch.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Цвета — те же токены, что в styles.css версии 3.x. -->
      <Color x:Key="BgColor">#0F1116</Color>
      <SolidColorBrush x:Key="Bg" Color="#0F1116"/>
      <SolidColorBrush x:Key="Rail" Color="#12141A"/>
      <SolidColorBrush x:Key="Surface" Color="#171A21"/>
      <SolidColorBrush x:Key="Surface2" Color="#1E222B"/>
      <SolidColorBrush x:Key="Surface3" Color="#262B36"/>
      <SolidColorBrush x:Key="Line" Color="#2A2F3B"/>
      <SolidColorBrush x:Key="Text" Color="#E8EBF2"/>
      <SolidColorBrush x:Key="Muted" Color="#98A1B2"/>
      <SolidColorBrush x:Key="Faint" Color="#6B7385"/>
      <SolidColorBrush x:Key="Brand" Color="#7C5CFF"/>
      <SolidColorBrush x:Key="Brand2" Color="#9D85FF"/>
      <SolidColorBrush x:Key="BrandSoft" Color="#2A2350"/>
      <SolidColorBrush x:Key="Good" Color="#3DD68C"/>
      <SolidColorBrush x:Key="Warn" Color="#F2B84B"/>
      <SolidColorBrush x:Key="Bad" Color="#FF6B6B"/>
      <SolidColorBrush x:Key="Hover" Color="#FFFFFF" Opacity="0.06"/>
      <FontFamily x:Key="ContentControlThemeFontFamily">fonts:Inter#Inter</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#7C5CFF" RegionColor="#0F1116" ErrorText="#FF6B6B"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource Bg}"/>
      <Setter Property="FontFamily" Value="fonts:Inter#Inter"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <!-- Текст -->
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="TextBlock.h3"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
    <Style Selector="TextBlock.small"><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="TextBlock.brand"><Setter Property="Foreground" Value="{StaticResource Brand2}"/></Style>

    <!-- Карточки -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <!-- Кнопки: общая основа -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3}"/>
      <Setter Property="BorderBrush" Value="#3A4150"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="Button:pressed"><Setter Property="RenderTransform" Value="scale(0.97)"/></Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Brand}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Brand2}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3}"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}"/>
    </Style>

    <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.45"/></Style>

    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.win">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.win:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource Hover}"/></Style>
    <Style Selector="Button.close:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#E5484D"/></Style>

    <!-- Чипы разделов и вкладки -->
    <Style Selector="Button.chip">
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style Selector="Button.chip.active">
      <Setter Property="Background" Value="{StaticResource Brand}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.chip.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Brand2}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Padding" Value="16,10"/>
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="Background" Value="{StaticResource BrandSoft}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <!-- Кнопки игр на боковой панели -->
    <Style Selector="Button.rail">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Button.rail.active"><Setter Property="BorderBrush" Value="{StaticResource Brand}"/></Style>
    <Style Selector="Button.rail:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource Hover}"/></Style>

    <!-- Плитки игр -->
    <Style Selector="Button.tile">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.tile:pointerover"><Setter Property="RenderTransform" Value="translateY(-3px)"/></Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter"><Setter Property="BorderBrush" Value="{StaticResource Brand}"/></Style>

    <!-- Поля ввода -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderBrush" Value="#3A4150"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinHeight" Value="40"/>
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource Brand}"/>
      <Setter Property="Background" Value="{StaticResource Surface3}"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="MinHeight" Value="6"/>
      <Setter Property="Height" Value="6"/>
    </Style>

    <Style Selector="ScrollViewer">
      <Setter Property="AllowAutoHide" Value="True"/>
    </Style>

    <!-- Мягкое появление страниц -->
    <Style Selector="ContentControl#Page > :is(Control)">
      <Style.Animations>
        <Animation Duration="0:0:0.18" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- 5.5: анимации. Работают, когда у корня окна есть класс anim (настройка «Анимации»). -->
    <Style Selector=".anim Button.rise">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector=".anim Button.rise:pointerover"><Setter Property="RenderTransform" Value="translateY(-5px)"/></Style>
    <Style Selector=".anim Button.rise:pointerover /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="0 14 34 0 #55000000"/>
    </Style>
    <Style Selector=".anim Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="0 6 22 0 #557C5CFF"/>
    </Style>
    <Style Selector=".anim Border.skeleton">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.85"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector=".anim Border.float">
      <Style.Animations>
        <Animation Duration="0:0:3.2" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-6"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="6"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector=".anim Border.pulse">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0.8"/><Setter Property="ScaleTransform.ScaleY" Value="0.8"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1.25"/><Setter Property="ScaleTransform.ScaleY" Value="1.25"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector=".anim Button.rail">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector=".anim Button.rail:pointerover"><Setter Property="RenderTransform" Value="scale(1.08)"/></Style>
    <Style Selector=".anim Button.chip">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector=".anim Button.chip:pointerover"><Setter Property="RenderTransform" Value="translateY(-1px)"/></Style>
    <Style Selector="Border.hero">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
    </Style>
    <Style Selector=".anim Border.hero">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#2A2350" Offset="0"/>
          <GradientStop Color="#171A21" Offset="0.65"/>
        </LinearGradientBrush>
      </Setter>
    </Style>
  </Application.Styles>
</Application>
